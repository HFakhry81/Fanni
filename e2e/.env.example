# LambdaTest — copy to e2e/.env (never commit real keys)
LT_USERNAME=your_lambdatest_username
LT_ACCESS_KEY=your_lambdatest_access_key

# Optional
LT_BUILD=Fanni E2E Build
LT_PLATFORM=Windows 11

# Free cloud runner (recommended): GitHub Actions workflow
#   .github/workflows/e2e-playwright.yml
#   Docs: e2e/CLOUD_E2E.md
# Put the same E2E_* values in GitHub Actions secrets (not only this file).

# Force video + screenshots + trace on ALL projects (optional)
# E2E_RECORD=1

# ── Production (default E2E against live) ─────────────────────────────────────
E2E_BASE_URL=https://app.upnexa-eg.com
E2E_API_URL=https://api.upnexa-eg.com

# Production / shared authenticated journeys (fill in e2e/.env — never commit)
# Client (customer)
E2E_CLIENT_IDENTIFIER=
E2E_CLIENT_PASSWORD=
# Technician
E2E_TECH_IDENTIFIER=
E2E_TECH_PASSWORD=
# Second technician (optional multi-tech journeys)
E2E_TECH2_IDENTIFIER=
E2E_TECH2_PASSWORD=
# Admin (seeded API bootstrap: mobile/email admin, password admin)
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# ── Local development (use with E2E_BASE_URL / E2E_API_URL pointing at LAN) ───
# Example:
#   E2E_BASE_URL=http://192.168.1.17:8081
#   E2E_API_URL=http://192.168.1.17:3000
E2E_LOCAL_BASE_URL=
E2E_LOCAL_API_URL=
E2E_LOCAL_CLIENT_IDENTIFIER=
E2E_LOCAL_CLIENT_PASSWORD=
E2E_LOCAL_TECH_IDENTIFIER=
E2E_LOCAL_TECH_PASSWORD=
E2E_LOCAL_ADMIN_IDENTIFIER=
E2E_LOCAL_ADMIN_PASSWORD=
