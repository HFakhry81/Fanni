# â”€â”€â”€ Fanni â€” Environment Variables â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then run:
#   pnpm --filter @workspace/api-server run dev
#   pnpm --filter @workspace/mobile run dev
#
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local PostgreSQL (PgAdmin 4 default): postgresql://postgres:<password>@localhost:5432/fanni_db
# Create the DB first:  createdb fanni_db  OR  use PgAdmin 4 to create it
DATABASE_URL="postgresql://postgres:<YOUR_LOCAL_DB_PASSWORD>@localhost:5432/fanni_db"

# â”€â”€ API Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# â”€â”€ Session â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_32byte_hex_string

# â”€â”€ OTP / Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# false = skip OTP in dev (password login only). true = require OTP (needs SMS).
ENABLE_OTP=false

# â”€â”€ Email (SMTP) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave all SMTP_ vars unset to disable email in dev (OTPs/resets logged to console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=Fanni <noreply@fanni.app>

# â”€â”€ SMS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave all SMS_ vars unset to disable SMS in dev (OTP codes logged to console).
# SMS_PROVIDER=vonage
# SMS_API_KEY=your_vonage_key
# SMS_API_SECRET=your_vonage_secret
# SMS_FROM_NUMBER=+20xxxxxxxxxx
# SMS_SENDER_ID=Fanni

# â”€â”€ Masked calling (Twilio Voice bridge) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Public HTTPS origin of this API (no trailing slash). Required for TwiML webhooks.
# PUBLIC_API_URL=https://api.upnexa-eg.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_VOICE_NUMBER=+20xxxxxxxxxx
# Firebase App ID / package name are NOT Twilio credentials. Put Twilio values only on the VPS .env.

# â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated browser origins allowed with credentials. Native apps send no Origin.
# Production: set this explicitly. Do not use a wildcard.
# CORS_ORIGINS=https://api.upnexa-eg.com,https://app.upnexa-eg.com

# Auto-refund cap per technician per day (wrong number / no answer, no call click).
# DISPUTE_AUTO_DAILY_CAP=2

# â”€â”€ Payments â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Live path is manual bank / InstaPay until OPay credentials arrive.
# PAYMENT_PROVIDER=manual
# Do not hardcode OPay fees. Gateway adapter: artifacts/api-server/src/lib/paymentGateway.ts

# â”€â”€ Object Storage (file uploads) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# STORAGE_DRIVER=local writes privately under PRIVATE_OBJECT_DIR (no public URLs).
# Production VPS (Node user must be able to write; never put SSH passwords in git/chat):
#   STORAGE_DRIVER=local
#   PRIVATE_OBJECT_DIR=/var/www/storage/fanni
#   PRIVATE_OBJECT_DIR_ID=/var/www/storage/fanni/id
#   PRIVATE_OBJECT_DIR_CARNEHAT=/var/www/storage/fanni/carnehat
# GCS remains available with STORAGE_DRIVER=gcs + ADC / GOOGLE_APPLICATION_CREDENTIALS.
STORAGE_DRIVER=local
PRIVATE_OBJECT_DIR=./uploads
# PRIVATE_OBJECT_DIR_ID=./uploads/id
# PRIVATE_OBJECT_DIR_CARNEHAT=./uploads/carnehat

# â”€â”€ OpenAI (optional, unused after OCR removal) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Maps / Geo â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Optional â€” needed only for real-time traffic overlays.
# TOMTOM_API_KEY=your_tomtom_key

# â”€â”€ Order Broadcasting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Radius in km for notifying nearby technicians. Defaults: 10 km, tiers 5/10/20.
# BROADCAST_RADIUS_KM=10
# BROADCAST_RADIUS_TIERS_KM=5,10,20

# â”€â”€ Mobile App (Expo) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Point the mobile app at the local API server.
# For Expo Web in the browser on the same machine:
#   EXPO_PUBLIC_API_URL=http://localhost:3000
# For Expo Go on a physical phone (same Wi-Fi):
#   Replace <LAN_IP> with your machine's local IP (from: ip addr / ipconfig / ifconfig)
#   EXPO_PUBLIC_API_URL=http://<LAN_IP>:3000
# Production web/APK builds:
#   EXPO_PUBLIC_API_URL=https://api.upnexa-eg.com
#   EXPO_PUBLIC_DOMAIN=app.upnexa-eg.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# â”€â”€ Google Sign-In / OIDC (mobile social login) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Default issuer is Google. Create OAuth clients in Google Cloud Console
# (Web + Android package com.fanni.app + SHA-1 of EAS signing key).
# ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=xxxxx.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=xxxxx

# â”€â”€ E2E / Playwright (LambdaTest) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# See e2e/.env.example â€” never commit real LT_ACCESS_KEY.
# LT_USERNAME=your_lambdatest_username
# LT_ACCESS_KEY=your_lambdatest_access_key
# E2E_BASE_URL=https://app.upnexa-eg.com
# E2E_API_URL=https://api.upnexa-eg.com
