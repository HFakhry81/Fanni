# ─── Fanni — Environment Variables ───────────────────────────────────────────
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Replit: all variables are set automatically via the Replit environment.
# Locally:   fill in the values below and run:
#              pnpm --filter @workspace/api-server run dev
#              pnpm --filter @workspace/mobile run dev
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL (PgAdmin 4 default): postgresql://postgres:<password>@localhost:5432/fanni_db
# Create the DB first:  createdb fanni_db  OR  use PgAdmin 4 to create it
DATABASE_URL="postgresql://postgres:<YOUR_LOCAL_DB_PASSWORD>@localhost:5432/fanni_db"

# ── API Server ────────────────────────────────────────────────────────────────
# On Replit: PORT is set automatically to 8080 — do NOT change it here.
# Locally:   PORT=3000
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_32byte_hex_string

# ── OTP / Auth ────────────────────────────────────────────────────────────────
# false = skip OTP in dev (password login only). true = require OTP (needs SMS).
ENABLE_OTP=false

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave all SMTP_ vars unset to disable email in dev (OTPs/resets logged to console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=Fanni <noreply@fanni.app>

# ── SMS ───────────────────────────────────────────────────────────────────────
# Leave all SMS_ vars unset to disable SMS in dev (OTP codes logged to console).
# SMS_PROVIDER=vonage
# SMS_API_KEY=your_vonage_key
# SMS_API_SECRET=your_vonage_secret
# SMS_FROM_NUMBER=+20xxxxxxxxxx
# SMS_SENDER_ID=Fanni

# ── Masked calling (Twilio Voice bridge) ─────────────────────────────────────
# Public HTTPS origin of this API (no trailing slash). Required for TwiML webhooks.
# PUBLIC_API_URL=https://api.your-domain.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_VOICE_NUMBER=+20xxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed with credentials. Native apps send no Origin.
# Production: set this explicitly. Do not use a wildcard.
# CORS_ORIGINS=https://api.upnexa-eg.com,https://app.upnexa-eg.com

# ── Payments ──────────────────────────────────────────────────────────────────
# Live path is manual bank / InstaPay until OPay credentials arrive.
# PAYMENT_PROVIDER=manual
# Do not hardcode OPay fees. Gateway adapter: artifacts/api-server/src/lib/paymentGateway.ts

# ── Object Storage (file uploads) ─────────────────────────────────────────────
# STORAGE_DRIVER=local writes privately under PRIVATE_OBJECT_DIR (no public URLs).
# VPS path later: STORAGE_DRIVER=local and PRIVATE_OBJECT_DIR=/var/fanni/uploads
# GCS remains available with STORAGE_DRIVER=gcs — files stay private.
STORAGE_DRIVER=local
PRIVATE_OBJECT_DIR=./uploads

# ── OpenAI (optional, unused after OCR removal) ───────────────────────────────

# ── Maps / Geo ────────────────────────────────────────────────────────────────
# Optional — needed only for real-time traffic overlays.
# TOMTOM_API_KEY=your_tomtom_key

# ── Order Broadcasting ────────────────────────────────────────────────────────
# Radius in km for notifying nearby technicians. Defaults: 10 km, tiers 5/10/20.
# BROADCAST_RADIUS_KM=10
# BROADCAST_RADIUS_TIERS_KM=5,10,20

# ── Mobile App (Expo) ─────────────────────────────────────────────────────────
# Point the mobile app at the local API server.
# On Replit: EXPO_PUBLIC_API_URL is set automatically by scripts/dev-start.js.
# Locally:   set this to your machine's local API URL.
# For Expo Web in the browser on the same machine:
#   EXPO_PUBLIC_API_URL=http://localhost:3000
# For Expo Go on a physical phone (same Wi-Fi):
#   Replace <LAN_IP> with your machine's local IP (from: ip addr / ipconfig / ifconfig)
#   EXPO_PUBLIC_API_URL=http://<LAN_IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
