# Copy to the VPS next to the app (never commit the real file).
# Apache + PM2 listen on 127.0.0.1:5000. Public URL is Cloudflare → https://api.upnexa-eg.com

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Public origin for TwiML webhooks (Twilio). Not the Android package name.
PUBLIC_API_URL=https://api.upnexa-eg.com

# Browser admin / Expo web. Native APK sends no Origin.
CORS_ORIGINS=https://api.upnexa-eg.com,https://app.upnexa-eg.com

DISPUTE_AUTO_DAILY_CAP=2
PAYMENT_PROVIDER=manual
# ENABLE_OTP=true

STORAGE_DRIVER=local
PRIVATE_OBJECT_DIR=/var/www/storage/fanni
PRIVATE_OBJECT_DIR_ID=/var/www/storage/fanni/id
PRIVATE_OBJECT_DIR_CARNEHAT=/var/www/storage/fanni/carnehat

# Existing on the VPS — do not paste passwords into git or chat.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/fanni_db
# SESSION_SECRET=

# Mobile builds (EAS / local) should use:
# EXPO_PUBLIC_API_URL=https://api.upnexa-eg.com
# EXPO_PUBLIC_SENTRY_DSN=https://...@....ingest.de.sentry.io/...

# Sentry API (optional overrides — defaults match production DSN in code)
# SENTRY_DSN=
# SENTRY_RELEASE=fanni-api@1.0.9
# SENTRY_ENVIRONMENT=production

# Twilio Voice — leave unset until Console SID (AC…) + Auth Token exist.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VOICE_NUMBER=
