{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "preinstall": "echo pnpm",
    "prepare": "node ./scripts/src/install-git-hooks.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "review:update": "pnpm --filter @workspace/scripts run review:update",
    "review:log": "node ./scripts/src/log-commit-to-review.mjs --head",
    "review:seed": "node ./scripts/src/log-commit-to-review.mjs --seed 40",
    "typecheck:libs": "pnpm --filter @workspace/db build && tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server --filter @workspace/mobile --filter @workspace/scripts run typecheck",
    "lint": "eslint \"artifacts/mobile/**/*.{ts,tsx}\" \"artifacts/api-server/src/**/*.ts\"",
    "test": "pnpm --filter @workspace/mobile run test && pnpm --filter @workspace/api-server run test",
    "test:e2e": "pnpm --filter @workspace/e2e run test",
    "test:e2e:local": "pnpm --filter @workspace/e2e run test:local",
    "test:e2e:lt": "pnpm --filter @workspace/e2e run test:lt",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:mobile": "pnpm --filter @workspace/mobile run dev",
    "local:update": "powershell -ExecutionPolicy Bypass -File ./scripts/local-update.ps1",
    "export:web": "powershell -ExecutionPolicy Bypass -File ./scripts/export-web.ps1",
    "migrate": "pnpm --filter @workspace/db run migrate",
    "env:export-prod": "powershell -ExecutionPolicy Bypass -File ./scripts/export-prod-env-for-git.ps1"
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.27.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jimp": "^1.6.1",
    "@swc/helpers": "^0.5.23"
  }
}