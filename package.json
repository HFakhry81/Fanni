{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "echo pnpm",
    "prepare": "node ./scripts/src/install-git-hooks.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "review:update": "pnpm --filter @workspace/scripts run review:update",
    "review:log": "node ./scripts/src/log-commit-to-review.mjs --head",
    "review:seed": "node ./scripts/src/log-commit-to-review.mjs --seed 40",
    "typecheck:libs": "pnpm --filter @workspace/db build && tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:mobile": "pnpm --filter @workspace/mobile run dev",
    "migrate": "pnpm --filter @workspace/db run migrate"
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.27.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jimp": "^1.6.1"
  }
}
