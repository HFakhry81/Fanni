# Fanni PRODUCTION draft — LOCAL MACHINE ONLY (copy to .env.production, never commit)
#   copy .env.production.example .env.production
# Fill secrets locally, then: pnpm run env:export-prod
# VPS keeps real secrets in /var/www/fanni/.env

NODE_ENV=production
PORT=5000
LOG_LEVEL=info
PUBLIC_API_URL=https://api.upnexa-eg.com
CORS_ORIGINS=https://api.upnexa-eg.com,https://app.upnexa-eg.com
DISPUTE_AUTO_DAILY_CAP=2
PAYMENT_PROVIDER=manual
STORAGE_DRIVER=local
PRIVATE_OBJECT_DIR=/var/www/storage/fanni
PRIVATE_OBJECT_DIR_ID=/var/www/storage/fanni/id
PRIVATE_OBJECT_DIR_CARNEHAT=/var/www/storage/fanni/carnehat
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/fanni_db
# SESSION_SECRET=
EXPO_PUBLIC_API_URL=https://api.upnexa-eg.com
EXPO_PUBLIC_DOMAIN=app.upnexa-eg.com
# EXPO_PUBLIC_SENTRY_DSN=  (see deploy/env.production.example)
# SENTRY_DSN=              (see deploy/env.production.example)
SENTRY_RELEASE=fanni-api@1.0.10
SENTRY_ENVIRONMENT=production
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VOICE_NUMBER=
