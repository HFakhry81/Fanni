# Fanni LOCAL development template — copy to .env (gitignored)
#   copy .env.local.example .env
# Production Git template: deploy/env.production.example
# Local prod draft (gitignored): .env.production
# Export safe prod vars to Git: pnpm run env:export-prod

DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/fanni_db
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET=local_dev_change_me_32chars_minimum_xx
ENABLE_OTP=false
STORAGE_DRIVER=local
PRIVATE_OBJECT_DIR=./uploads
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DOMAIN=localhost
EXPO_PUBLIC_REPL_ID=local
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=fanni-api@local
# E2E_BASE_URL=http://localhost:8081
# E2E_API_URL=http://localhost:3000
