# ─── Fanni Mobile App — Local Development Environment ────────────────────────
#
# Copy this file to .env for local development:
#   cp artifacts/mobile/.env.example artifacts/mobile/.env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── API Server URL ────────────────────────────────────────────────────────────
# Point this at your local API server (port 8080 by default).
#
# For Expo Web in the browser on the same machine:
#   EXPO_PUBLIC_API_URL=http://localhost:8080
#
# For Expo Go on a physical phone (same Wi-Fi network):
#   Replace <YOUR_LOCAL_IP> with your machine's LAN IP (e.g. 192.168.1.42)
#
EXPO_PUBLIC_API_URL=http://localhost:8080

# ── Google Sign-In (OIDC) ─────────────────────────────────────────────────────
# Create OAuth clients in Google Cloud Console for package com.fanni.app
# (Android needs SHA-1 of the signing key used by EAS).
# Also set matching vars on the API server:
#   ISSUER_URL=https://accounts.google.com
#   OIDC_CLIENT_ID=<same web client id>
#   OIDC_CLIENT_SECRET=<web client secret, if confidential>
#
EXPO_PUBLIC_ISSUER_URL=https://accounts.google.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── OTP (optional) ───────────────────────────────────────────────────────────
# Set ENABLE_OTP=false in the API server's .env to skip OTP during local dev.
